+int LLDTSyncProcPhyStatusFrame(void *hEnet, uint8_t coreId, uint8_t macPort,
+							   uint8_t *frame, uint32_t size)
+{
+	int32_t status = ENET_SOK;
+	Enet_IoctlPrms prms;
+	EnetPhy_PtpStatusFrameInArgs inArgs;
+
+	if ((hEnet == NULL) || (frame == NULL) || (size == 0U)) {
+		return LLDENET_E_PARAM;
+	}
+
+	inArgs.macPort = (Enet_MacPort)macPort;
+	inArgs.frame = frame;
+	inArgs.frameLen = size;
+	ENET_IOCTL_SET_IN_ARGS(&prms, &inArgs);
+	ENET_IOCTL((Enet_Handle)hEnet, coreId,
+			   ENET_PHY_IOCTL_PTP_PROCESS_STATUS_FRAME, &prms, status);
+	if (status == ENET_ENOTSUPPORTED) {
+		return LLDENET_E_UNSUPPORT;
+	}
+	if (status != ENET_SOK) {
+		return LLDENET_E_IOCTL;
+	}
+
+	return LLDENET_E_OK;
+}
+
+int LLDTSyncGetStatusFrameEthHeader(void *hEnet, uint8_t coreId, uint8_t macPort,
+									uint8_t *ethHdr, uint32_t size)
+{
+	int32_t status = ENET_SOK;
+	Enet_IoctlPrms prms;
+	EnetPhy_GenericInArgs inArgs;
+	EnetPhy_PtpStatusFrameEthHdrOutArgs outArgs;
+
+	if ((hEnet == NULL) || (ethHdr == NULL) || (size < sizeof(outArgs.ethHdr))) {
+		return LLDENET_E_PARAM;
+	}
+
+	memset(&outArgs, 0, sizeof(outArgs));
+	inArgs.macPort = (Enet_MacPort)macPort;
+	ENET_IOCTL_SET_INOUT_ARGS(&prms, &inArgs, &outArgs);
+	ENET_IOCTL((Enet_Handle)hEnet, coreId,
+			   ENET_PHY_IOCTL_PTP_GET_STATUS_FRAME_ETHDR, &prms, status);
+	if (status == ENET_ENOTSUPPORTED) {
+		return LLDENET_E_UNSUPPORT;
+	}
+	if (status != ENET_SOK) {
+		return LLDENET_E_IOCTL;
+	}
+
+	memcpy(ethHdr, outArgs.ethHdr, sizeof(outArgs.ethHdr));
+	return LLDENET_E_OK;
+}
