+        status = ENETPHY_EBADARGS;
+    }
+    else if ((hPhy->hDrv == NULL) || (hPhy->hDrv->getPtpRxTime == NULL))
+    {
+        status = ENET_ENOTSUPPORTED;
+    }
+    else
+    {
+        status = hPhy->hDrv->getPtpRxTime(hPhy,
+                                          inArgs->macPort,
+                                          inArgs->msgType,
+                                          inArgs->seqId,
+                                          inArgs->domain,
+                                          outTs);
+    }
+
+    ENETTRACE_ERR_IF(!EnetPhyMdioDflt_isExpectedPtpLookupStatus(status),
+                     "Port %u: Failed to get PHY RX timestamp: %d\n",
+                     (inArgs != NULL) ? ENET_MACPORT_ID(inArgs->macPort) : 0U, status);
+    return status;
+}
