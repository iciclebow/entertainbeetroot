+    {
+        EnetOsal_lockMutex(hEnet->lock);
+
+        hPer = Enet_getPerHandle(hEnet);
+        Enet_devAssert(hPer != NULL, "Invalid EnetPer handle\n");
+
+        EnetPer_poll(hPer, evt, arg, argSize);
+
+        EnetOsal_unlockMutex(hEnet->lock);
