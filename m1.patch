+static int LLDEnetEnsureStatusFrameHdr(LLDEnet_t *hLLDEnet)
+{
+	int status;
+
+	if (hLLDEnet->phyStatusFrameHdrValid) {
+		return LLDENET_E_OK;
+	}
+	if (hLLDEnet->phyStatusFrameHdrUnavailable) {
+		return LLDENET_E_UNSUPPORT;
+	}
+
+	/* Current PHY backend exposes a fixed Layer-2 status frame header. */
+	status = LLDTSyncGetStatusFrameEthHeader(hLLDEnet->hEnet,
+											 (uint8_t)hLLDEnet->coreId,
+											 (uint8_t)ENET_MAC_PORT_1,
+											 hLLDEnet->phyStatusFrameHdr,
+											 sizeof(hLLDEnet->phyStatusFrameHdr));
+	if (status != LLDENET_E_OK) {
+		hLLDEnet->phyStatusFrameHdrUnavailable = true;
+		return status;
+	}
+
+	hLLDEnet->phyStatusFrameHdrValid = true;
+	return LLDENET_E_OK;
+}
