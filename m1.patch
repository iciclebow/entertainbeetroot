+static void LLDEnetLogStatusDrain(LLDEnet_t *hLLDEnet)
+{
+	if ((hLLDEnet->statusDrainCalls <= 3U) ||
+		((hLLDEnet->statusDrainCalls % 1000U) == 0U)) {
+		UB_LOG(UBL_INFO,
+			   "%s: calls=%u drainedStatus=%u retainedNonStatus=%u\n",
