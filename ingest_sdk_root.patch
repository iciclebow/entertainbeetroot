-                case ENET_STATS_IOCTL_GET_HOSTPORT_STATS:
-                case ENET_STATS_IOCTL_GET_MACPORT_STATS:
-                case ENET_STATS_IOCTL_RESET_HOSTPORT_STATS:
-                case ENET_STATS_IOCTL_RESET_MACPORT_STATS:
