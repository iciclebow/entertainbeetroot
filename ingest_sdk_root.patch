-                    break;
-
-                default:
-#if ENET_CFG_IS_ON(DEV_ERROR)
-                    status = Enet_validateIoctl(cmd, prms, validIoctls, numValidIoctls);
-#endif
-                    break;
-            }
-        }
-    }
-
-    return status;
-}
