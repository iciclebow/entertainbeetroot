+static void Dp83tc812_ageTxWaitQ(uint32_t nowTick)
+{
+    uint32_t i;
+
+    for (i = 0U; i < DP83TC812_PTP_WAITQ_DEPTH; i++)
+    {
+        Dp83tc812_PtpTxWaitEntry *waitEntry = &gDp83tc812TxWaitQ[i];
+
+        if (waitEntry->valid && (nowTick >= waitEntry->deadlineTick))
+        {
+            waitEntry->valid = false;
+            if (gDp83tc812TxWaitCount > 0U)
+            {
+                gDp83tc812TxWaitCount--;
+            }
+            gDp83tc812PsfWaitExpireCnt++;
+        }
+    }
+}
+
+static void Dp83tc812_pushReadyEntry(Dp83tc812_PtpReadyQueue *queue,
+                                     const Dp83tc812_PtpTsEntry *entry)
+{
+    Dp83tc812_PtpTsEntry *dst = &queue->entries[queue->writeIdx];
+
+    if (!dst->valid)
+    {
+        queue->count++;
+    }
+
+    *dst = *entry;
+    dst->valid = true;
+    queue->writeIdx = (queue->writeIdx + 1U) % DP83TC812_PSF_RING_DEPTH;
+}
+
+static bool Dp83tc812_domainMatches(uint8_t entryDomain, uint8_t queryDomain)
+{
+    return ((entryDomain == DP83TC812_PTP_DOMAIN_WILDCARD) || (entryDomain == queryDomain));
+}
+
+static int32_t Dp83tc812_popReadyTs(Dp83tc812_PtpReadyQueue *queue,
+                                    Enet_MacPort macPort,
+                                    uint8_t msgType,
+                                    uint16_t seqId,
+                                    uint8_t domain,
+                                    uint64_t *ts)
+{
+    uint32_t i;
+
+    for (i = 0U; i < DP83TC812_PSF_RING_DEPTH; i++)
+    {
+        Dp83tc812_PtpTsEntry *entry = &queue->entries[i];
+
+        if (entry->valid &&
+            (entry->macPort == macPort) &&
+            (entry->msgType == msgType) &&
+            (entry->seqId == seqId) &&
+            Dp83tc812_domainMatches(entry->domain, domain))
+        {
+            *ts = entry->ts64;
+            entry->valid = false;
+            if (queue->count > 0U)
+            {
+                queue->count--;
+            }
+            return ENETPHY_SOK;
+        }
+    }
+
+    return ENET_ENOTFOUND;
+}
+
+static int32_t Dp83tc812_registerTxWait(Enet_MacPort macPort,
+                                        uint8_t msgType,
+                                        uint16_t seqId,
+                                        uint8_t domain)
+{
+    uint32_t nowTick = Dp83tc812_nextOracleTick();
+    uint32_t i;
+    int32_t slot = -1;
+
+    Dp83tc812_ageTxWaitQ(nowTick);
+
+    for (i = 0U; i < DP83TC812_PTP_WAITQ_DEPTH; i++)
+    {
+        Dp83tc812_PtpTxWaitEntry *waitEntry = &gDp83tc812TxWaitQ[i];
+
+        if (waitEntry->valid &&
+            (waitEntry->macPort == macPort) &&
+            (waitEntry->msgType == msgType) &&
+            (waitEntry->seqId == seqId) &&
+            (waitEntry->domain == domain))
+        {
+            waitEntry->deadlineTick = nowTick + DP83TC812_PTP_WAIT_TTL_TICKS;
+            return ENETPHY_SOK;
+        }
+
+        if ((!waitEntry->valid) && (slot < 0))
+        {
+            slot = (int32_t)i;
+        }
+    }
+
+    if (slot < 0)
+    {
+        slot = (int32_t)gDp83tc812TxWaitWriteIdx;
+    }
+
+    if (!gDp83tc812TxWaitQ[slot].valid)
+    {
+        gDp83tc812TxWaitCount++;
+    }
+
+    gDp83tc812TxWaitQ[slot].valid = true;
+    gDp83tc812TxWaitQ[slot].macPort = macPort;
+    gDp83tc812TxWaitQ[slot].msgType = msgType;
+    gDp83tc812TxWaitQ[slot].seqId = seqId;
+    gDp83tc812TxWaitQ[slot].domain = domain;
+    gDp83tc812TxWaitQ[slot].deadlineTick = nowTick + DP83TC812_PTP_WAIT_TTL_TICKS;
+    gDp83tc812TxWaitQ[slot].waitIndex = gDp83tc812PsfWaitSeq++;
+    gDp83tc812TxWaitWriteIdx = ((uint32_t)slot + 1U) % DP83TC812_PTP_WAITQ_DEPTH;
+    gDp83tc812PsfWaitRegCnt++;
+
+    return ENETPHY_SOK;
+}
+
+static bool Dp83tc812_matchTxWait(Enet_MacPort macPort,
+                                  uint8_t msgType,
+                                  uint16_t seqId,
+                                  uint8_t *domain)
+{
+    uint32_t nowTick = Dp83tc812_nextOracleTick();
+    uint32_t i;
+
+    Dp83tc812_ageTxWaitQ(nowTick);
+
+    for (i = 0U; i < DP83TC812_PTP_WAITQ_DEPTH; i++)
+    {
+        Dp83tc812_PtpTxWaitEntry *waitEntry = &gDp83tc812TxWaitQ[i];
+
+        if (waitEntry->valid &&
+            (waitEntry->macPort == macPort) &&
+            (waitEntry->msgType == msgType) &&
+            (waitEntry->seqId == seqId))
+        {
+            *domain = waitEntry->domain;
+            waitEntry->valid = false;
+            if (gDp83tc812TxWaitCount > 0U)
+            {
+                gDp83tc812TxWaitCount--;
+            }
+            return true;
+        }
+    }
+
+    return false;
+}
