+static uint16_t LLDEnetDbgGetEthType(const uint8_t *frame, int size, uint32_t *l2HdrLen)
+{
+	uint16_t ethType = 0U;
+	uint32_t hdrLen = 14U;
+
+	if ((frame == NULL) || (size < (int)hdrLen)) {
+		if (l2HdrLen != NULL) {
+			*l2HdrLen = 0U;
+		}
+		return 0U;
+	}
+
+	ethType = ((uint16_t)frame[12] << 8U) | frame[13];
+	while (((ethType == 0x8100U) || (ethType == 0x88A8U)) &&
+		   (size >= (int)(hdrLen + 4U))) {
+		hdrLen += 4U;
+		ethType = ((uint16_t)frame[hdrLen - 2U] << 8U) | frame[hdrLen - 1U];
+	}
+
+	if (l2HdrLen != NULL) {
+		*l2HdrLen = hdrLen;
+	}
+	return ethType;
+}
+
+static uint8_t LLDEnetDbgGetPtpMsgType(const uint8_t *frame, int size,
+									   uint32_t l2HdrLen, uint16_t *seqId)
+{
+	uint8_t msgType = 0xFFU;
+
+	if ((frame != NULL) && (size > (int)l2HdrLen)) {
+		msgType = frame[l2HdrLen] & 0x0FU;
+	}
+
+	if (seqId != NULL) {
+		*seqId = 0xFFFFU;
+		if ((frame != NULL) && (size >= (int)(l2HdrLen + 32U))) {
+			*seqId = ((uint16_t)frame[l2HdrLen + 30U] << 8U) |
+					 frame[l2HdrLen + 31U];
+		}
+	}
+
+	return msgType;
+}
+
+static void LLDEnetDbgTracePtpRoute(const char *stage,
+									LLDEnetRxDma_t *hLLDRxDma,
+									const void *buf,
+									int size,
+									uint8_t portNum,
+									int subRxIndex)
+{
+	const uint8_t *frame = (const uint8_t *)buf;
+	uint32_t l2HdrLen = 0U;
+	uint16_t ethType = 0U;
+	uint16_t seqId = 0xFFFFU;
+	uint8_t msgType = 0xFFU;
+
+	if (gLldEnetPtpRxOwnerTraceCount >= LLDENET_PTP_RX_OWNER_DEBUG_FIRST_N) {
+		return;
+	}
+
+	ethType = LLDEnetDbgGetEthType(frame, size, &l2HdrLen);
+	if (ethType != ETH_P_1588) {
+		return;
+	}
+
+	msgType = LLDEnetDbgGetPtpMsgType(frame, size, l2HdrLen, &seqId);
+	gLldEnetPtpRxOwnerTraceCount++;
+	UB_LOG(UBL_INFO,
+		   "%s: stage=%s trace=%u rxChId=%d shared=%d subRx=%d port=%u size=%d type=0x%02x seqId=%u dst=%02x:%02x:%02x:%02x:%02x:%02x src=%02x:%02x:%02x:%02x:%02x:%02x\n",
+		   __func__,
+		   stage,
+		   gLldEnetPtpRxOwnerTraceCount,
+		   hLLDRxDma->rxChId,
+		   hLLDRxDma->dmaRxShared,
+		   subRxIndex,
+		   portNum,
+		   size,
+		   msgType,
+		   seqId,
+		   frame[0], frame[1], frame[2], frame[3], frame[4], frame[5],
+		   frame[6], frame[7], frame[8], frame[9], frame[10], frame[11]);
+}
+#else
+static void LLDEnetDbgTracePtpRoute(const char *stage,
+									LLDEnetRxDma_t *hLLDRxDma,
+									const void *buf,
+									int size,
+									uint8_t portNum,
+									int subRxIndex)
+{
+	(void)stage;
+	(void)hLLDRxDma;
+	(void)buf;
+	(void)size;
+	(void)portNum;
+	(void)subRxIndex;
+}
+#endif
