+
+static int32_t Dp83tc812_getPtpTxTime(EnetPhy_Handle hPhy,
+                                      Enet_MacPort macPort,
+                                      uint8_t msgType,
+                                      uint16_t seqId,
+                                      uint8_t domain,
+                                      uint64_t *ts)
+{
+    int32_t status;
+
+    ENET_UNUSED(hPhy);
+
+    if (ts == NULL)
+    {
+        return ENETPHY_EBADARGS;
+    }
+
+    status = Dp83tc812_popReadyTs(&gDp83tc812TxReadyQ, macPort, msgType, seqId, domain, ts);
+    if (status == ENETPHY_SOK)
+    {
+        gDp83tc812PsfTxLookupHitCnt++;
+    }
+    else
+    {
+        gDp83tc812PsfTxLookupMissCnt++;
+    }
+
+    return status;
+}
