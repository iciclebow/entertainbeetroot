+int LLDTSyncWaitTxTime(LLDTSync_t *hTSync, uint8_t txPort, int msgType,
+					   uint16_t seqId, uint8_t domain)
+{
+	int32_t status = ENET_SOK;
+
+	if (hTSync == NULL) {
+		return LLDENET_E_PARAM;
+	}
+
+	if (!hTSync->phyWaitEnabled)
+	{
+		return LLDENET_E_OK;
+	}
+
+	status = LLDTSync_tryPhyWait(hTSync, txPort, msgType, seqId, domain);
+	if (status == ENET_SOK) {
+		hTSync->phyWaitOkCnt++;
+		LLDTSync_maybeLogSummary(hTSync);
+		return LLDENET_E_OK;
+	}
+	if ((status == ENET_ENOTSUPPORTED) ||
+		(status == ENETPHY_ENOTSUPPORTED))
+	{
+		hTSync->phyWaitEnabled = false;
+		UB_LOG(UBL_INFO,
+			   "%s: PHY TX wait unsupported, continuing with CPTS-only live timestamps\n",
+			   __func__);
+		return LLDENET_E_OK;
+	}
+	if (status == ENET_ENOTFOUND)
+	{
+		hTSync->phyWaitMissCnt++;
+		if (LLDTSync_shouldLogCounter(hTSync->phyWaitMissCnt))
+		{
+			UB_LOG(UBL_INFO,
+				   "%s: PHY TX wait not registered for port=%u msgType=%d seqId=%u domain=%u, continuing with CPTS\n",
+				   __func__, txPort, msgType, seqId, domain);
+		}
+		LLDTSync_maybeLogSummary(hTSync);
+		return LLDENET_E_OK;
+	}
+
+	hTSync->phyWaitErrCnt++;
+	if (LLDTSync_shouldLogCounter(hTSync->phyWaitErrCnt))
+	{
+		UB_LOG(UBL_WARN,
+			   "%s: PHY TX wait failed for port=%u msgType=%d seqId=%u domain=%u (status=%d), continuing with CPTS\n",
+			   __func__, txPort, msgType, seqId, domain, status);
+	}
+	LLDTSync_maybeLogSummary(hTSync);
 	return LLDENET_E_OK;
 }
 
