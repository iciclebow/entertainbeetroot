-int32_t Enet_validateIoctl(uint32_t cmd,
-                           const Enet_IoctlPrms *prms,
-                           const Enet_IoctlValidate *validIoctls,
-                           uint32_t numValidIoctls)
-{
-    const Enet_IoctlValidate *ioctlInfo;
