+static bool EnetPhyMdioDflt_isExpectedPtpLookupStatus(int32_t status)
+{
+    return (status == ENET_SOK) ||
+           (status == ENET_ENOTFOUND) ||
+           (status == ENET_ENOTSUPPORTED) ||
+           (status == ENETPHY_ENOTSUPPORTED);
+}
