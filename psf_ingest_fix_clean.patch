+static bool IsRxFilterSet(LLDEnetRxFilter_t *filter)
+{
+	return ((filter->vlanId > 0U) || (filter->ethType > 0U) ||
+		IsMacAddrSet(filter->dstMacAddr));
+}
+
+static bool IsRxFilterEqual(const LLDEnetRxFilter_t *lhs,
+				      const LLDEnetRxFilter_t *rhs)
+{
+	return ((lhs->vlanId == rhs->vlanId) &&
+		(lhs->ethType == rhs->ethType) &&
+		(memcmp(lhs->dstMacAddr, rhs->dstMacAddr, ENET_MAC_ADDR_LEN) == 0));
+}
