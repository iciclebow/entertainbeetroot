+int32_t  EnetPhyMdioDflt_ioctl_handler_ENET_PHY_IOCTL_PTP_GET_STATUS_FRAME_ETHDR(EnetPhy_Handle hPhy, Enet_IoctlPrms *prms)
+{
+    const EnetPhy_GenericInArgs *inArgs = (const EnetPhy_GenericInArgs *)prms->inArgs;
+    EnetPhy_PtpStatusFrameEthHdrOutArgs *outArgs = (EnetPhy_PtpStatusFrameEthHdrOutArgs *)prms->outArgs;
+    int32_t status = ENET_SOK;
+    uint32_t macPortId = 0U;
+
+    if ((inArgs == NULL) || (outArgs == NULL))
+    {
+        status = ENETPHY_EBADARGS;
+    }
+    else if ((hPhy->hDrv == NULL) || (hPhy->hDrv->getStatusFrameEthHeader == NULL))
+    {
+        status = ENET_ENOTSUPPORTED;
+    }
+    else
+    {
+        status = hPhy->hDrv->getStatusFrameEthHeader(hPhy,
+                                                     inArgs->macPort,
+                                                     outArgs->ethHdr,
+                                                     sizeof(outArgs->ethHdr));
+    }
+
+    if (inArgs != NULL)
+    {
+        macPortId = ENET_MACPORT_ID(inArgs->macPort);
+    }
+
+    ENETTRACE_ERR_IF(status != ENETPHY_SOK,
+                     "Port %u: Failed to get PHY status frame header: %d\n",
+                     macPortId, status);
+    return status;
+}
