+static bool Dp83tc812_isMacModeSupported(EnetPhy_Handle hPhy,
+                                       EnetPhy_Mii mii)
+{
+    bool supported = false;
+
+    switch (mii)
+    {
+        case ENETPHY_MAC_MII_MII:
+			break;
+        case ENETPHY_MAC_MII_GMII:
+			break;
+        case ENETPHY_MAC_MII_RGMII:
+			supported = true;
+            break;
+		case ENETPHY_MAC_MII_SGMII:
+            supported = true;
+            break;
+        default:
+            supported = false;
+            break;
+    }
+
+    return supported;
