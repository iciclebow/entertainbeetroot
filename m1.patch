+int LLDEnetProcessStatusFrames(LLDEnet_t *hLLDEnet)
+{
+	EnetDma_PktQ retainedQ;
+	EnetDma_PktQ drainedQ;
+	EnetDma_Pkt *pktInfo;
+	uint32_t rxReadyCnt;
+	uint32_t pktSize;
+	uint8_t *rxFrame;
+	bool isStatusFrame;
+	int status;
+	int drained = 0;
+	int retained = 0;
+	int firstError = 0;
+
+	if ((hLLDEnet == NULL) || (hLLDEnet->dmaRxOwner == false)) {
+		return 0;
+	}
+
+	rxReadyCnt = EnetQueue_getQCount(&hLLDEnet->rxReadyQ);
+	if (rxReadyCnt == 0U) {
+		return 0;
+	}
+
+	status = LLDEnetEnsureStatusFrameHdr(hLLDEnet);
+	if (status != LLDENET_E_OK) {
+		return 0;
+	}
+
+	EnetQueue_initQ(&retainedQ);
+	EnetQueue_initQ(&drainedQ);
+	hLLDEnet->statusDrainCalls++;
+
+	while (rxReadyCnt-- > 0U) {
+		pktInfo = (EnetDma_Pkt *)EnetQueue_deq(&hLLDEnet->rxReadyQ);
+		if (pktInfo == NULL) {
+			break;
+		}
+
+		EnetAppUtils_assert(pktInfo->sgList.numScatterSegments == 1U);
+		rxFrame = (uint8_t *)EnetUtils_physToVirt((uint64_t)pktInfo->sgList.list[0].bufPtr, NULL);
+		pktSize = pktInfo->sgList.list[0].segmentFilledLen;
+		isStatusFrame = ((pktSize >= sizeof(hLLDEnet->phyStatusFrameHdr)) &&
+						 (memcmp(rxFrame, hLLDEnet->phyStatusFrameHdr,
+								 sizeof(hLLDEnet->phyStatusFrameHdr)) == 0));
+
+		if (!isStatusFrame) {
+			EnetQueue_enq(&retainedQ, &pktInfo->node);
+			retained++;
+			continue;
+		}
+
+		status = LLDTSyncProcPhyStatusFrame(hLLDEnet->hEnet,
+											 (uint8_t)hLLDEnet->coreId,
+											 (uint8_t)pktInfo->rxPortNum,
+											 rxFrame,
+											 pktSize);
+		if ((status != LLDENET_E_OK) && (firstError == 0)) {
+			firstError = status;
+		}
+		EnetQueue_enq(&drainedQ, &pktInfo->node);
+		drained++;
+	}
+
+	EnetQueue_append(&hLLDEnet->rxReadyQ, &retainedQ);
+	hLLDEnet->statusDrainedFrames += (uint32_t)drained;
+	hLLDEnet->statusRetainedNonStatus += (uint32_t)retained;
+	LLDEnetLogStatusDrain(hLLDEnet);
+
+	pktInfo = (EnetDma_Pkt *)EnetQueue_deq(&drainedQ);
+	while (pktInfo != NULL) {
+		LLDEnetRecycleRxPkt(pktInfo);
+		pktInfo = (EnetDma_Pkt *)EnetQueue_deq(&drainedQ);
+	}
+
+	if (firstError != 0) {
+		return firstError;
+	}
+
+	return drained;
+}
