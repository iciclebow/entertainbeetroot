+int32_t EnetPhyMdioDflt_ioctl_handler_ENET_PHY_IOCTL_PTP_WAIT_TX_TIMESTAMP(EnetPhy_Handle hPhy,
+                                                                            Enet_IoctlPrms *prms)
+{
+    const EnetPhy_PtpTimestampInArgs *inArgs = (const EnetPhy_PtpTimestampInArgs *)prms->inArgs;
+    int32_t status = ENET_SOK;
+
+    if (inArgs == NULL)
+    {
+        status = ENETPHY_EBADARGS;
+    }
+    else if ((hPhy->hDrv == NULL) || (hPhy->hDrv->waitPtpTxTime == NULL))
+    {
+        status = ENET_ENOTSUPPORTED;
+    }
+    else
+    {
+        status = hPhy->hDrv->waitPtpTxTime(hPhy,
+                                           inArgs->macPort,
+                                           inArgs->msgType,
+                                           inArgs->seqId,
+                                           inArgs->domain);
+    }
+
+    ENETTRACE_ERR_IF(!EnetPhyMdioDflt_isExpectedPtpLookupStatus(status),
+                     "Port %u: Failed to register PHY TX timestamp wait: %d\n",
+                     (inArgs != NULL) ? ENET_MACPORT_ID(inArgs->macPort) : 0U, status);
+    return status;
+}
+
+int32_t EnetPhyMdioDflt_ioctl_handler_ENET_PHY_IOCTL_PTP_GET_TX_TIMESTAMP(EnetPhy_Handle hPhy,
+                                                                           Enet_IoctlPrms *prms)
+{
+    const EnetPhy_PtpTimestampInArgs *inArgs = (const EnetPhy_PtpTimestampInArgs *)prms->inArgs;
+    uint64_t *outTs = (uint64_t *)prms->outArgs;
+    int32_t status = ENET_SOK;
+
+    if ((inArgs == NULL) || (outTs == NULL))
+    {
+        status = ENETPHY_EBADARGS;
+    }
+    else if ((hPhy->hDrv == NULL) || (hPhy->hDrv->getPtpTxTime == NULL))
+    {
+        status = ENET_ENOTSUPPORTED;
+    }
+    else
+    {
+        status = hPhy->hDrv->getPtpTxTime(hPhy,
+                                          inArgs->macPort,
+                                          inArgs->msgType,
+                                          inArgs->seqId,
+                                          inArgs->domain,
+                                          outTs);
+    }
+
+    ENETTRACE_ERR_IF(!EnetPhyMdioDflt_isExpectedPtpLookupStatus(status),
+                     "Port %u: Failed to get PHY TX timestamp: %d\n",
+                     (inArgs != NULL) ? ENET_MACPORT_ID(inArgs->macPort) : 0U, status);
+    return status;
+}
